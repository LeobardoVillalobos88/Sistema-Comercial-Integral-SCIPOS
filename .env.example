# =============================================================================
# SCIPOS — Configuración del despliegue
# =============================================================================
#
# Cópialo como .env en la raíz del proyecto y llena los valores. Es el único
# archivo que hay que tocar para desplegar:
#
#   cp .env.example .env
#
# El .env NO se versiona (está en .gitignore). No lo subas al repositorio.
#
# Arranque:
#   docker compose -f infra/docker/compose/docker-compose.prod.yml --env-file .env build
#   docker compose -f infra/docker/compose/docker-compose.prod.yml --env-file .env up -d
#
# El procedimiento completo está en docs/DESPLIEGUE-AWS.md
# =============================================================================


# -----------------------------------------------------------------------------
# Base de datos PostgreSQL
# -----------------------------------------------------------------------------
# Credenciales del contenedor de Postgres. Cámbialas: los valores de ejemplo
# son los de desarrollo local y no deben usarse en una máquina expuesta.
# Los seis servicios comparten esta base y cada uno usa su propio esquema.
POSTGRES_USER=scipos
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
POSTGRES_DB=scipos


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Cachea privilegios y guarda la lista de tokens revocados.
REDIS_PASSWORD=CAMBIA_ESTA_CONTRASENA


# -----------------------------------------------------------------------------
# Firma de tokens JWT (RS256)
# -----------------------------------------------------------------------------
# El servicio de seguridad firma con la llave privada y publica la pública en
# su JWKS; los demás servicios solo verifican. Genera tu propio par y no
# reutilices el de otra instalación:
#
#   pnpm generar:llaves      crea keys/jwt_private.pem y keys/jwt_public.pem
#   pnpm llaves:entorno      imprime las dos líneas de abajo ya codificadas
#
# Van en base64 porque un archivo .env no admite valores de varias líneas.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Identifican al emisor y al destinatario de los tokens. Deben coincidir en
# todos los servicios; cámbialos solo si sabes por qué.
JWT_ISSUER=scipos-auth
JWT_AUDIENCE=scipos-api

# Vida del token de acceso (15 min) y del de refresco (7 días), en segundos.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800


# -----------------------------------------------------------------------------
# Red y acceso público
# -----------------------------------------------------------------------------
# Puerto que nginx publica en la instancia. Es el único puerto de la
# aplicación que debe abrirse en el grupo de seguridad de AWS.
PUERTO_PUBLICO=80

# Dominio del sistema. Solo lo usa la superposición de TLS
# (infra/docker/compose/docker-compose.tls.yml): nginx lo sustituye en su
# configuración y Let's Encrypt emite el certificado a su nombre. Déjalo vacío
# mientras se sirva por HTTP con la IP.
#   Ejemplo: DOMINIO=scipos.tech
DOMINIO=

# Dirección desde la que el navegador consume la API. Con el proxy inverso la
# interfaz y la API comparten origen, así que la ruta relativa funciona con
# cualquier dominio o IP y no hay que reconstruir la imagen al cambiarlos.
NEXT_PUBLIC_API_URL=/api

# Orígenes autorizados a consumir el gateway desde otro dominio, separados por
# comas. Detrás del proxy no hacen falta: déjalo vacío salvo que un cliente
# externo (por ejemplo una app móvil o un frontend en otro host) deba entrar.
#   Ejemplo: ORIGENES_PERMITIDOS=https://scipos.midominio.com,http://54.12.3.4
ORIGENES_PERMITIDOS=


# -----------------------------------------------------------------------------
# Arranque de la base de datos
# -----------------------------------------------------------------------------
# Aplica las migraciones pendientes al levantar cada servicio. Es idempotente,
# así que puede quedarse en true de forma permanente.
EJECUTAR_MIGRACIONES=true

# Carga los datos iniciales: catálogo de privilegios, matriz de roles, los
# cuatro usuarios y los datos de demostración. Ponlo en true para el PRIMER
# arranque, levanta, y vuélvelo a false para que no se recargue en cada
# reinicio.
EJECUTAR_SEMILLA=false


# -----------------------------------------------------------------------------
# Contraseñas de los usuarios iniciales
# -----------------------------------------------------------------------------
# La semilla crea un usuario por rol. Si dejas estas variables vacías se usan
# las contraseñas de desarrollo documentadas en el README, que son públicas:
# defínelas si la instancia va a estar expuesta a internet.
#
#   admin@scipos.com       ADMINISTRADOR
#   vendedor@scipos.com    VENDEDOR
#   cajero@scipos.com      CAJERO
#   supervisor@scipos.com  SUPERVISOR
SEED_ADMIN_PASSWORD=
SEED_VENDEDOR_PASSWORD=
SEED_CAJERO_PASSWORD=
SEED_SUPERVISOR_PASSWORD=

# El quinto usuario es el que la skill de Alexa usa para entrar. Cambiarlo
# importa más que los anteriores: su contraseña de desarrollo viaja escrita en
# el código de la skill, que está en el repositorio, y la cuenta puede registrar
# productos y entradas de inventario.
#
#   asistente@scipos.com   asistente de voz (solo almacén)
#
# Al cambiarla, actualiza también el valor en apps/alexa-skill/lambda/index.js
# antes de pegar el archivo en la consola de Alexa, o la skill no podrá entrar.
SEED_ASISTENTE_PASSWORD=


# -----------------------------------------------------------------------------
# Alertas de inventario
# -----------------------------------------------------------------------------
# Cuándo el sistema avisa al operador, al entrar, de lo que necesita atención.
# Los mismos umbrales alimentan las cifras del dashboard.

# Existencia igual o menor que esto cuenta como stock bajo. En cero, agotado.
UMBRAL_STOCK_BAJO=5

# Días de anticipación con los que se avisa de una caducidad. Lo ya vencido
# se reporta siempre, sin importar este número.
DIAS_AVISO_CADUCIDAD=14
