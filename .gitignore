keys/

# Carpeta de práctica del profesor (no forma parte del proyecto)
ControlAcceso/

# UAT
.uat-logs/

# Grafo local de code-review-graph (indice, no se versiona)
.code-review-graph/

# Cache local del detector de diseno (la config si se versiona)
.impeccable/hook.cache.json
