package-lock.json
yarn.lock

# Builds / cache
.next/
out/
dist/
build/
.turbo/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Entorno
.env
.env*.local

# Sistema operativo / editores
.DS_Store
Thumbs.db
*.tsbuildinfo

# Llaves RSA para firmar JWT: nunca se versionan (cada quien genera las suyas
