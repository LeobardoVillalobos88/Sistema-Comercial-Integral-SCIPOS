# Copia este archivo como .env y ajusta puerto y schema a los de tu servicio:
# productos 4002, clientes 4003, cotizaciones 4004, ventas-caja 4005, reportes 4006.
PORT=4007
DATABASE_URL="postgresql://root:root@localhost:5432/scipos?schema=ejemplo"
REDIS_URL="redis://:root@localhost:6379"
SEGURIDAD_URL=http://localhost:4001
# Secreto para verificar los JWT (igual en todos los servicios).
JWT_SECRETO=scipos-secreto-dev
