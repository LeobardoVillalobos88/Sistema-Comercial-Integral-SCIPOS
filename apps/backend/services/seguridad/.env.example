# Copia este archivo como .env y ajusta si tu infraestructura local difiere.
PORT=4001
DATABASE_URL="postgresql://root:root@localhost:5432/scipos?schema=seguridad"
REDIS_URL="redis://:root@localhost:6379"
# Firma y verificación de tokens JWT RS256.
# La privada firma; la pública se publica en el JWKS. Genera las llaves con `pnpm generar:llaves`.
JWT_PRIVATE_KEY_PATH=../../../../keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=../../../../keys/jwt_public.pem
JWT_ISSUER=scipos-auth
JWT_AUDIENCE=scipos-api
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
