# Copia este archivo como .env y ajusta si tu infraestructura local difiere.
PORT=4006
REDIS_URL="redis://:root@localhost:6379"
SEGURIDAD_URL=http://localhost:4001
PRODUCTOS_URL=http://localhost:4002
CLIENTES_URL=http://localhost:4003
COTIZACIONES_URL=http://localhost:4004
VENTAS_CAJA_URL=http://localhost:4005
# Verificación de tokens JWT RS256 (mismos valores en todos los servicios).
JWT_ISSUER=scipos-auth
JWT_AUDIENCE=scipos-api
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
