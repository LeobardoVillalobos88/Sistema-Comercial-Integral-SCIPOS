# Copia este archivo como .env
PORT=4002
DATABASE_URL="postgresql://root:root@localhost:5432/scipos?schema=productos"
REDIS_URL="redis://:root@localhost:6379"
SEGURIDAD_URL=http://localhost:4001
# Verificación de tokens JWT RS256 (mismos valores en todos los servicios).
JWT_ISSUER=scipos-auth
JWT_AUDIENCE=scipos-api
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
# Umbrales de las alertas de inventario (los mismos que usa el resumen del dashboard).
# Existencia igual o menor que esto cuenta como stock bajo.
UMBRAL_STOCK_BAJO=5
# Dias de anticipacion con los que se avisa de una caducidad.
DIAS_AVISO_CADUCIDAD=14
