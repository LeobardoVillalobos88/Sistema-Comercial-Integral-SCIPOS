# Configuración del web-shell para desarrollo local.
# Cópialo como .env.local y ajusta si tu gateway no está en el puerto 4000.
#
# En el despliegue con contenedores esta variable NO se toma de aquí: Next la
# resuelve al compilar, así que entra como argumento de construcción de la
# imagen desde el .env de la raíz del proyecto.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
