{
  "name": "scipos",
  "version": "0.0.0",
  "private": true,
  "description": "SCIPOS — Sistema Comercial Integral (LOBOSOFT / UTEZ)",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "infra:up": "docker compose -f infra/docker/compose/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/docker/compose/docker-compose.dev.yml down",
    "setup:backend": "pnpm infra:up && pnpm --filter @scipos/backend-commons build && pnpm --filter @scipos/seguridad-service prisma:generate && pnpm --filter @scipos/seguridad-service prisma:deploy && pnpm --filter @scipos/seguridad-service seed",
    "start": "turbo run start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
