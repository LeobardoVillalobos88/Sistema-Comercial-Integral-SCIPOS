# syntax=docker/dockerfile:1

# Imagen del web-shell, que embebe los microfrontends como paquetes del
# workspace y por lo tanto se compila como una sola aplicación Next.

# La versión coincide con la de .nvmrc. No bajarla: pnpm 11 usa node:sqlite,
# que no existe antes de Node 22.5, y la instalación falla sin dependencias.
FROM node:22-slim AS base
# Los NPM_CONFIG_* dan margen de red: pnpm verifica cada entrada del lockfile
# contra el registro y, con una conexión lenta, esa consulta expira y aborta la
# instalación como si el paquete hubiera sido rechazado. Se sube el tiempo de
# espera en lugar de relajar la política de cadena de suministro.
ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH" \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NPM_CONFIG_FETCH_TIMEOUT=600000 \
    NPM_CONFIG_FETCH_RETRIES=5 \
    NPM_CONFIG_NETWORK_CONCURRENCY=8 \
    NPM_CONFIG_STORE_DIR=/pnpm/store \
    NPM_CONFIG_PACKAGE_IMPORT_METHOD=copy
# `prepare` deja pnpm dentro de la imagen. La etapa de ejecución arranca con
# `pnpm start`, así que necesita pnpm disponible sin descargarlo al iniciar.
RUN corepack enable && corepack prepare pnpm@11.8.0 --activate
WORKDIR /app

FROM base AS construccion
# Next resuelve las variables NEXT_PUBLIC_* al compilar, no al arrancar: por
# eso la dirección de la API entra como argumento de construcción y no como
# variable del contenedor.
#
# El valor por defecto es una ruta relativa a propósito. Detrás del proxy
# inverso la interfaz y la API comparten origen, así que la misma imagen sirve
# en cualquier dominio o IP sin reconstruirse.
ARG NEXT_PUBLIC_API_URL=/api
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
COPY . .
# La caché del almacén de pnpm sobrevive entre construcciones: al actualizar el
# proyecto en la instancia no se vuelven a descargar las dependencias enteras.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile
# Concurrencia limitada por la misma razón que en la imagen de backend: la
# compilación de Next reserva mucha memoria y el demonio de Docker muere sin
# error legible si se queda sin ella.
RUN pnpm exec turbo run build --concurrency=2 --filter=@scipos/web-shell

FROM base AS ejecucion
ENV NODE_ENV=production \
    PORT=3001
COPY --from=construccion /app /app
WORKDIR /app/apps/frontend/web-shell
EXPOSE 3001
CMD ["pnpm", "start"]
